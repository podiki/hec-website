---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import Calendar from '~/components/widgets/Calendar.astro';
const metadata = {
  title: 'Upcoming Events',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Calendar" title="Upcoming Events" />

  <Calendar/>

  <Content>
  <Fragment slot="content">
      Here's direct link to the <u><a href="https://calendar.google.com/calendar/embed?src=637dfe346b2ef4fef7ce87e4a679defcc2dd5b569d052b34358144b7060116ed%40group.calendar.google.com&ctz=America%2FNew_York">Google calendar</a></u> and as an <u><a href="https://calendar.google.com/calendar/ical/637dfe346b2ef4fef7ce87e4a679defcc2dd5b569d052b34358144b7060116ed%40group.calendar.google.com/public/basic.ics">iCal calendar</a></u>
  </Fragment>
  <Fragment slot="content">
  See also other events and ways to get involved at the latest <u><a href=2025-05-events>Hawthorne news and upcoming events post</a></u>.
  </Fragment>
  </Content>
</Layout>
